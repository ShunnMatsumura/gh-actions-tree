{
  "manifest_version": 3,
  "name": "GH Actions Tree",
  "version": "0.1.3",
  "description": "Organize GitHub Actions workflows into a collapsible folder tree based on [A][B]_name prefixes.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  }
}
